{
  "name": "hynite",
  "version": "0.26.0",
  "private": true,
  "main": "out/main/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev --config apps/desktop/electron.vite.config.ts",
    "dev:profile": "node scripts/electron-vite.mjs --startup-profile dev --config apps/desktop/electron.vite.config.ts",
    "dev:onboarding": "node scripts/electron-vite.mjs --onboarding-preview dev --config apps/desktop/electron.vite.config.ts",
    "profile:latest": "node scripts/read-latest-profile-report.mjs",
    "build": "npm run typecheck && electron-vite build --config apps/desktop/electron.vite.config.ts",
    "installer": "npm run build && npm run native:publish && electron-builder --win nsis",
    "release": "npm run build && node scripts/release.mjs",
    "release:preview": "node scripts/release-preview.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:logos": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-logo-assets.ps1",
    "native:build": "dotnet build native/Hynite.NativeBridge/Hynite.NativeBridge.csproj",
    "native:publish": "dotnet publish native/Hynite.NativeBridge/Hynite.NativeBridge.csproj -c Release -r win-x64 --self-contained true -o dist/native/Hynite.NativeBridge"
  },
  "build": {
    "appId": "app.hynite.launcher",
    "productName": "Hynite",
    "directories": {
      "output": "dist/installer"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/icons",
        "to": "icons"
      },
      {
        "from": "assets/audio",
        "to": "audio"
      },
      {
        "from": "dist/native/Hynite.NativeBridge",
        "to": "native/Hynite.NativeBridge"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/app.ico",
      "executableName": "Hynite",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "guid": "app.hynite.launcher",
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Hynite"
    },
    "publish": {
      "provider": "github",
      "owner": "yuma-dev",
      "repo": "hynite",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.0.4",
    "electron-updater": "^6.6.2",
    "electron-vite": "^4.0.1",
    "framer-motion": "^12.15.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.544.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/ui": "^3.2.4",
    "electron": "^39.8.5",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
