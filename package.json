{
  "name": "hynite",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev --config apps/desktop/electron.vite.config.ts",
    "build": "npm run typecheck && electron-vite build --config apps/desktop/electron.vite.config.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:logos": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-logo-assets.ps1",
    "native:build": "dotnet build native/Hynite.NativeBridge/Hynite.NativeBridge.csproj"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "electron-vite": "^4.0.1",
    "framer-motion": "^12.15.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.544.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/ui": "^3.2.4",
    "electron": "^39.8.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
